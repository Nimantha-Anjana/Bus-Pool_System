# ---------- Server ----------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Public base URL of this API (used for the links inside assignment e-mails)
API_PUBLIC_URL=http://localhost:5000
# Set to 1 when the API runs behind a reverse proxy / load balancer (Nginx, Render, ...),
# so rate limiting and the activity log see the real client IP. Leave empty for local development.
TRUST_PROXY=

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bus_pool_system
DB_USER=root
DB_PASSWORD=

# ---------- JWT (each secret: 32+ characters) ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Seed admin ----------
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@buspoolsystem.local
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
ADMIN_PHONE=

# ---------- E-mail (assignment notifications) ----------
# Leave SMTP_HOST empty in development: e-mails are then only previewed in the console
# and the accept/reject links are returned in the API response ("devActionLinks").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bus Pool <no-reply@buspool.local>
ASSIGNMENT_TOKEN_EXPIRES_HOURS=48

# ---------- Optional ----------
# Several allowed frontend origins: FRONTEND_URL=https://app.example.lk,https://www.example.lk
# Cookie for the refresh token: lax (same site) | none (frontend and API on different domains, HTTPS only)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Swagger UI at /api/docs (default: on in development, off in production)
ENABLE_API_DOCS=
# Background jobs: 48 h reminder e-mails, failed e-mail retry, expired-link alerts, clean-up
SLOW_REQUEST_MS=1000
RUN_JOBS=true
REMINDER_HOURS_BEFORE=48
# GPS: minimum seconds between two live points / what the driver app should aim for / keep points of finished tours N days (0 = forever)
GPS_MIN_INTERVAL_SECONDS=5
GPS_RECOMMENDED_INTERVAL_SECONDS=15
GPS_RETENTION_DAYS=0
# Slack / Discord / Teams incoming-webhook URL that receives every server error
ERROR_WEBHOOK_URL=
# Backups (npm run db:backup)
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
