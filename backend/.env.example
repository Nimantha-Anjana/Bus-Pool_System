# ---------- Server ----------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Public base URL of this API (used for the links inside assignment e-mails)
API_PUBLIC_URL=http://localhost:5000

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bus_pool_system
DB_USER=root
DB_PASSWORD=

# ---------- JWT (each secret: 32+ characters) ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Seed admin ----------
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@buspoolsystem.local
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
ADMIN_PHONE=

# ---------- E-mail (assignment notifications) ----------
# Leave SMTP_HOST empty in development: e-mails are then only previewed in the console
# and the accept/reject links are returned in the API response ("devActionLinks").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bus Pool <no-reply@buspool.local>
ASSIGNMENT_TOKEN_EXPIRES_HOURS=48
